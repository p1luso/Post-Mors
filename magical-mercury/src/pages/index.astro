---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---

<Layout title="Post Mors">
  <main>
    <div class="header">
      <img class="logo" src="/logo.png" />
      <div id="nav">
          <Nav />
      </div>
  </div>
      <div class="grid-container">
       
        <div class="left-side">
          <div class="leftSide-container">
            <div class="indImgs">
              <div class="indBackground"></div>
            </div>
          </div>
        </div>
        <div class="right-side">
          <div class="box-container">
            <div class="box">
              <div class="box-content">
                <h1 class="box-tittle">For Artists</h1>
                <p class="box-text">
                  Construcción de Roll-Outs, artes de tapa, visuales y estética
                  para artistas argentinos.
                </p>
                <div class="buttons">
                  <button class="btn btn-portfolio">Ver portfolio</button>
                  <a href="/presupuesto" class="btn btn-presupuesto"
                    >Pedir presupuesto</a
                  >
                </div>
              </div>
            </div>
            <div class="box">
              <div class="box-content">
                <h1 class="box-tittle">Branding</h1>
                <p class="box-text">
                  Construcción de sistema complejo de Diseño de marca, rebrading
                  o re-styling.
                </p>
                <div class="buttons">
                  <a href="/presupuesto" class="btn btn-presupuesto"
                    >Pedir presupuesto</a
                  >
                </div>
              </div>
            </div>
            <div class="box">
              <div class="box-content">
                <h1 class="box-tittle">UX/UI</h1>
                <p class="box-text">
                  Prototipado de app, web app o landing page para tu
                  emprendimiento o empresa.
                </p>
                <div class="buttons">
                  <button class="btn btn-portfolio">Ver portfolio</button>
                  <a href="/presupuesto" class="btn btn-presupuesto"
                    >Pedir presupuesto</a
                  >
                </div>
              </div>
            </div>
            <div class="box">
              <div class="box-content">
                <h1 class="box-tittle">Merch</h1>
                <p class="box-text">
                  Merchandising para artistas, empresas o emprendimientos.
                </p>
                <div class="buttons">
                  <button class="btn btn-portfolio">Ver portfolio</button>
                  <a href="/presupuesto" class="btn btn-presupuesto"
                    >Pedir presupuesto</a
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
  </main>
</Layout>

<style>
  /* Estilos generales */

  body,
  html,
  main {
    min-height: 90%;
    margin: 0;
    padding: 0;
    background: linear-gradient(#262525, #48560f); /* Fondo degradado */
    background-size: 100% 150%; /* El tamaño del fondo es el doble de la altura para permitir la animación */
    animation: gradient 5s ease infinite; /* Aplica la animación */
    display: flex;
    justify-content: center;

    flex-direction: column;
  }
  .hidden {
    display: none;
  }

  .logo {
        position: absolute;
       width: 5.8%;
       height: auto;
       left: 0px;
   }

   .header {
    display: flex;
    width: 90%;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 20px;
    }

  .btn-ls.active {
    background-color: white;
    color: black;
    border: 1px solid black;
  }

  @keyframes gradient {
    0% {
      background-position: 0% 0%;
    }
    50% {
      background-position: 0% 80%;
    }
    100% {
      background-position: 0% 0%;
    }
  }

  main {
    height: 100%;
    margin: 0;
    position: relative;
    align-items: center;
  }

  #nav {
    display: flex;
    position: relative;
    align-items: center;
    justify-content: center;
    padding: 20px; /* Espacio alrededor del contenido */
  }

  .grid-container {
    display: grid;
    grid-template-areas:
      "indImgs right-side" /* Logo y right-side en la misma fila */
      "left-side right-side"; /* Left-side en la fila siguiente, right-side en ambas filas */
    margin: 0% 16% 0% 5%; /* Centrar el contenedor horizontalmente */
    max-width: 100%;
    justify-content: center;
    align-items: center;
    position: relative; /* Necesario para posicionar el logo absolutamente */
  }

  .right-side {
    grid-area: right-side; /* Define el área del lado derecho */
    display: flex;
    flex-direction: column; /* Organiza el contenido en columnas si es necesario */
  }

  .leftSide-container
  {
    width:100%;
  }

  .left-side {
  display: flex;
  justify-content: center; /* Asegura que el contenido esté alineado a la izquierda */
  align-items: center; /* Opcional: alinea verticalmente el contenido */
}

.indImgs
{
  max-width: fit-content;
  max-height: fit-content;
  border-radius: 29px;
  border: 1px solid #fff;
}

.indBackground
{
  background-image: url(/indexImg.png);
  width: 48em; /* Ajusta el ancho según tu imagen */
  height: 43em;
  border-radius: 29px;
}

  .box-container {
    display: block;
    align-items: center;
    justify-self: center;
    margin-left: 15%; /* Cambiar a % para que se ajuste al tamaño de la pantalla */
    overflow-y: auto; /* Hace que el contenido sea desplazable */
    max-height: 80vh; /* Resta 50px del 100vh */
    scrollbar-width: none; /* Oculta la barra de desplazamiento para Firefox */
    -ms-overflow-style: none; /* Oculta la barra de desplazamiento para Internet Explorer */
  }

  .box-container::-webkit-scrollbar {
    display: none; /* Oculta la barra de desplazamiento para Chrome, Safari y Edge */
  }

  .box {
    border-radius: 29px;
    border: 1px solid #fff;
    margin-bottom: 3%;
    transition:
      background-color 0.3s ease,
      color 0.3s ease; /* Añade una transición suave */
  }

  .box:hover {
    background-color: white;
    box-shadow: 0px 4px 4px 0px rgba(0, 0, 0, 0.25);
    color: black;
  }

  .box:hover .box-text,
  .box:hover .box-tittle,
  .box:hover .btn {
    color: black; /* Cambia el color del texto a negro cuando el mouse está encima de .box */
  }

  .box:hover .btn {
    border: 1px solid black;
  }

  .box:hover .btn:hover {
    transition:
      background-color 0.3s ease,
      color 0.3s ease; /* Añade una transición suave */
    background-color: black;
    color: white;
    border: 1px solid white;
  }

  .box-content {
    padding: 20px;
  }

  .box-text {
    color: #fff;
    font-family: "ApfelGrotezkFett";
