<script
  type="text/javascript"
  src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"
></script>
<script type="text/javascript">
  (function () {
    // https://dashboard.emailjs.com/admin/account
    emailjs.init({
      publicKey: "nh0n8SRxdfzJxWhmE",
    });
  })();
</script>
<script type="text/javascript">
 function closePrompt() {
  document.getElementById("confirmation-promptt").classList.add("hidden");
}
 window.onload = function () {
    const form = document.getElementById("landing-form");
    const submitButton = document.getElementById("submit-button"); // Asegúrate de tener un id para el botón de envío
    const loader = document.getElementById("loader");
    const confirmationPrompt = document.getElementById("confirmation-promptt"); // Nuevo: referencia al prompt de confirmación

    form.addEventListener("submit", function (event) {
      event.preventDefault();

      // Deshabilitar el botón de envío
      submitButton.disabled = true;
      loader.classList.remove("hidden");
      const name = document.getElementById("name").value;
      const email = document.getElementById("email").value;
      const message = document.getElementById("message").value;
      const templateParams = {
        name: name,
        email: email,
        message: message,
      };

      emailjs
        .sendForm("service_7sd5ero", "template_dyx6cuf", this)
        .then(
          () => {
            console.log("SUCCESS!");
            // Mostrar el prompt de confirmación
            confirmationPrompt.classList.remove("hidden");

            // Limpiar el formulario
            form.reset();
          },
          (error) => {
            console.log("FAILED...", error);
            alert(
              "No se pudo enviar el mensaje. Por favor, intente de nuevo más tarde.",
            );
          },
        )
        .finally(() => {
          // Habilitar el botón de envío nuevamente
          submitButton.disabled = false;
          loader.classList.add("hidden");

          // Ocultar el formulario si es necesario
          form.classList.add("hidden");
        });
    });
  };
</script>


<script>
  document.addEventListener("DOMContentLoaded", function () {
    const contactBtn = document.getElementById("contact-btn");
    const contactFormContainer = document.getElementById("contact");
  
    // Mostrar la sección de contacto y resaltar el botón al cargar la página
    if (contactBtn && contactFormContainer) {
      contactFormContainer.classList.remove("hidden");
      contactBtn.classList.add("active");
    }
  
    // Manejar clics en los botones
    document.querySelectorAll(".btn-ls").forEach((button) => {
      button.addEventListener("click", function (this: HTMLElement) {
        const target = this.getAttribute("data-target");
  
        // Ocultar todas las secciones
        document.querySelectorAll(".content-section").forEach((section) => {
          section.classList.add("hidden");
        });
  
        // Mostrar la sección seleccionada
        const element = target ? document.getElementById(target) : null;
        if (element) {
          element.classList.remove("hidden");
        }
  
        // Eliminar la clase active de todos los botones
        document.querySelectorAll(".btn-ls").forEach((btn) => {
          btn.classList.remove("active");
        });
  
        // Añadir la clase active al botón clicado
        this.classList.add("active");
      });
    });
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
      const boxContainer = document.querySelector('.box-container');
      const scrollSpeed = 0.2; // Ajusta este valor para cambiar la velocidad (más bajo = más lento)

      // Escuchar el evento "wheel" en toda la página
      document.addEventListener('wheel', (event) => {
          if (boxContainer) {
              // Ajustar el desplazamiento aplicando un multiplicador para suavizar el scroll
              boxContainer.scrollTop += event.deltaY * scrollSpeed;
          }
      });
  });
</script>
